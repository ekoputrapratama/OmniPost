rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net - Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity shape validators
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().size() == 2
        && data.email is string
        && data.email.size() <= 256
        && data.createdAt is timestamp;
    }

    function isValidConnectedAccount(data) {
      return data.keys().hasAll(['userId', 'platform', 'method', 'encryptedData', 'createdAt'])
        && data.keys().size() == 5
        && (request.auth == null || data.userId == request.auth.uid)
        && data.platform is string
        && data.platform.size() <= 50
        && data.method is string
        && data.method.size() <= 50
        && data.encryptedData is string
        && data.encryptedData.size() <= 10000
        && data.createdAt is string
        && data.createdAt.size() <= 100;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'userId', 'content', 'platforms', 'status', 'createdAt', 'mediaUrls'])
        && data.keys().size() >= 7
        && data.keys().size() <= 10
        && (request.auth == null || data.userId == request.auth.uid)
        && data.id is string
        && data.id.size() <= 128
        && data.content is string
        && data.content.size() <= 5000
        && data.platforms is list
        && data.platforms.size() <= 10
        && data.status is string
        && data.status.size() <= 50
        && data.createdAt is string
        && data.createdAt.size() <= 100
        && data.mediaUrls is list
        && data.mediaUrls.size() <= 10
        && (data.get('scheduledFor', '') is string && data.get('scheduledFor', '').size() <= 100)
        && (data.get('publishedAt', '') is string && data.get('publishedAt', '').size() <= 100)
        && (data.get('error', '') is string && data.get('error', '').size() <= 1000);
    }

    // 4. Collection-specific match blocks
    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /connectedAccounts/{accountId} {
      allow read, delete: if (isSignedIn() && existing().userId == request.auth.uid) || (request.auth == null);
      allow create: if isSignedIn() && isValidId(accountId) && isValidConnectedAccount(incoming());
      allow update: if isSignedIn() && isValidId(accountId) && existing().userId == request.auth.uid && isValidConnectedAccount(incoming()) && incoming().createdAt == existing().createdAt;
    }

    match /posts/{postId} {
      allow read, delete: if (isSignedIn() && existing().userId == request.auth.uid) || (request.auth == null);
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if (
        (isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid && isValidPost(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt)
        ||
        (request.auth == null && isValidId(postId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedAt', 'error']))
      );
    }
  }
}
