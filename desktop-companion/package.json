{
  "name": "omnipost-companion",
  "version": "1.0.0",
  "description": "Desktop Companion for Omnipost Automation to extract session cookies securely.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --publish never"
  },
  "build": {
    "appId": "com.mixaline.omnipost",
    "productName": "OmniPost Desktop Companion",
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.15.3"
  }
}
